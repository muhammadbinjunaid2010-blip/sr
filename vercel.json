{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "api/leaderboard.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles/**", "use": "@vercel/static" },
    { "src": "app/**", "use": "@vercel/static" },
    { "src": "skillrun-*.{svg,jpg}", "use": "@vercel/static" },
    { "src": "desktop/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/leaderboard", "dest": "/api/leaderboard.js" },
    { "src": "/api/leaderboard/", "dest": "/api/leaderboard.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/app/?", "dest": "/app/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    { "source": "/app/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
    { "source": "/app/manifest.webmanifest", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/app/(css|js)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/skillrun-(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}